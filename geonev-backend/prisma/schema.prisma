generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =========================
// ENUMS
// =========================

enum UserRole {
  USER
  HOST
}

enum AuthProvider {
  LOCAL
  GOOGLE
  WHATSAPP
}

enum SpotType {
  CAR
  BIKE
  TRUCK
  EV_CHARGING
}

enum ChargerType {
  NONE
  AC
  DC
  BOTH
}

enum BookingStatus {
  PENDING // waiting for host approval
  CONFIRMED
  COMPLETED
  CANCELLED // cancelled by the user or the host
  REJECTED // declined by the host
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

// =========================
// USER
// =========================

model User {
  id           String       @id @default(cuid())
  name         String
  email        String?      @unique
  phone        String?      @unique
  googleId     String?      @unique
  passwordHash String?
  role         UserRole     @default(USER)
  provider     AuthProvider @default(LOCAL)
  isVerified   Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Auth relations
  passwordResetTokens PasswordResetToken[]
  otpRecords          OtpRecord[]

  // Parking relations
  parkings  Parking[]
  bookings  Booking[]
  reviews   Review[]
  favorites Favorite[]
}

// =========================
// PASSWORD RESET
// =========================

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

// =========================
// OTP
// =========================

model OtpRecord {
  id        String   @id @default(cuid())
  phone     String
  otpHash   String
  purpose   String
  attempts  Int      @default(0)
  expiresAt DateTime
  used      Boolean  @default(false)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([phone, purpose])
  @@index([userId])
}

// =========================
// PARKING / CHARGING STATION
// =========================

model Parking {
  id String @id @default(cuid())

  // Basic information
  name        String
  description String?
  address     String
  city        String
  state       String?
  pincode     String?

  // Location
  latitude  Float
  longitude Float

  // Parking / charging type
  spotType     SpotType
  totalSlots   Int
  pricePerHour Float
  pricePerDay  Float? // optional daily cap

  // Charger information
  chargerType    ChargerType @default(NONE)
  powerKw        Float?
  connectorTypes String[] // e.g. CCS2, Type2, CHAdeMO

  // Media / facilities
  images    String[]
  amenities String[]

  // Opening hours (HH:MM, 24h)
  isOpen24x7 Boolean @default(true)
  openTime   String?
  closeTime  String?

  // Booking behaviour: true = auto-confirm, false = host must approve
  instantBooking Boolean @default(true)

  // Denormalised rating (kept in sync by the review controller)
  avgRating   Float @default(0)
  reviewCount Int   @default(0)

  // Station status
  isActive Boolean @default(true)

  // Owner / host
  hostId String
  host   User   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  bookings  Booking[]
  reviews   Review[]
  favorites Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([spotType])
  @@index([hostId])
  @@index([isActive])
  @@index([latitude, longitude])
  @@index([pricePerHour])
  @@index([avgRating])
}

// =========================
// BOOKING
// =========================

model Booking {
  id String @id @default(cuid())

  startTime DateTime
  endTime   DateTime
  hours     Float
  totalPrice Float

  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)

  vehicleNumber String?
  note          String?
  cancelledAt   DateTime?

  parkingId String
  parking   Parking @relation(fields: [parkingId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  review Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parkingId, startTime, endTime])
  @@index([userId])
  @@index([status])
}

// =========================
// REVIEW
// =========================

model Review {
  id      String  @id @default(cuid())
  rating  Int // 1..5
  comment String?

  parkingId String
  parking   Parking @relation(fields: [parkingId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookingId String?  @unique
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parkingId, userId])
  @@index([parkingId])
}

// =========================
// FAVORITE
// =========================

model Favorite {
  userId    String
  parkingId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  parking Parking @relation(fields: [parkingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, parkingId])
  @@index([parkingId])
}
