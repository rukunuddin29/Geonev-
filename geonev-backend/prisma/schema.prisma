generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =========================
// ENUMS
// =========================

enum UserRole {
  USER
  HOST
}

enum AuthProvider {
  LOCAL
  GOOGLE
  WHATSAPP
}

enum SpotType {
  CAR
  BIKE
  TRUCK
  EV_CHARGING
}

enum ChargerType {
  NONE
  AC
  DC
  BOTH
}

// =========================
// USER
// =========================

model User {
  id           String       @id @default(cuid())
  name         String
  email        String?      @unique
  phone        String?      @unique
  googleId     String?      @unique
  passwordHash String?
  role         UserRole     @default(USER)
  provider     AuthProvider @default(LOCAL)
  isVerified   Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Auth relations
  passwordResetTokens PasswordResetToken[]
  otpRecords          OtpRecord[]

  // Parking relation
  parkings Parking[]
}

// =========================
// PASSWORD RESET
// =========================

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

// =========================
// OTP
// =========================

model OtpRecord {
  id        String   @id @default(cuid())
  phone     String
  otpHash   String
  purpose   String
  attempts  Int      @default(0)
  expiresAt DateTime
  used      Boolean  @default(false)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([phone, purpose])
  @@index([userId])
}

// =========================
// PARKING / CHARGING STATION
// =========================

model Parking {
  id String @id @default(cuid())

  // Basic information
  name    String
  address String
  city    String
  state   String?

  // Location
  latitude  Float
  longitude Float

  // Parking / charging type
  spotType     SpotType
  totalSlots   Int
  pricePerHour Float

  // Charger information
  chargerType ChargerType @default(NONE)
  powerKw     Float?

  // Media / facilities
  images    String[]
  amenities String[]

  // Station status
  isActive Boolean @default(true)

  // Owner / host
  hostId String
  host   User   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([spotType])
  @@index([hostId])
  @@index([isActive])
}